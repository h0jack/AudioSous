{
  "name": "audiosous",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop environment for hearing stems, marking song sections, and describing mix intent.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:analysis": "services/analysis/.venv/bin/python -m pytest -q services/analysis/tests",
    "generate-test-project": "npm run generate-test-project --workspace @audiosous/audio-files",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run tauri --workspace @audiosous/desktop -- dev",
    "stress:audio": "cargo test -p audiosous-audio --release --lib -- --ignored --nocapture --test-threads=1",
    "build": "npm run build --workspace @audiosous/desktop"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
